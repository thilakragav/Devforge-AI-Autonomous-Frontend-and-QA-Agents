# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=true

# AI / Vision LLM Configuration
# Supports: gemini, openai, anthropic, or demo
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# When DEMO_MODE=true, deterministic reference analysis and synthesis runs without requiring cloud credits
DEMO_MODE=false

# Astro Engine Configuration
ASTRO_BASE_PORT=4321
ASTRO_DEV_TIMEOUT_SECONDS=30

# File & Storage Paths
PROJECTS_DIR=generated_projects
UPLOADS_DIR=uploads
REPORTS_DIR=reports
